{
  "name": "pixel-agents-kimi-standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx concurrently \"bun run dev:server\" \"bun run dev:ui\"",
    "dev:server": "bunx tsx watch server/index.ts",
    "dev:ui": "cd webview-ui && bun run dev",
    "build": "bun run build:server && bun run build:ui",
    "build:server": "bunx esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:chokidar --external:ws --external:express --external:pngjs",
    "build:ui": "cd webview-ui && bun run build",
    "start": "bun dist/server.js",
    "import-tileset": "bunx tsx scripts/import-tileset.ts",
    "extract-furniture": "bunx tsx scripts/extract-furniture.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "express": "^5.0.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
